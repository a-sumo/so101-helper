{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a-sumo/so101-helper/schemas/assembly-sequence.schema.json",
  "title": "SO-101 Helper assembly sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "group", "durationMs"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "group": { "type": "string", "pattern": "^[A-Z0-9_-]{1,20}$" },
          "durationMs": { "type": "integer", "minimum": 250, "maximum": 120000 }
        }
      }
    }
  }
}
